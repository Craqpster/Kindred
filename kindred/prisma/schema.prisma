generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id          String    @id @db.Uuid
  username    String    @unique
  /// Age is derived from this on read: storing an age integer goes stale silently.
  birth_date  DateTime? @db.Date
  gender_id   Int?      @db.SmallInt
  avatar_id   String?
  /// Dicebear seed. Falls back to username when unset (ProfileHeader.tsx) - this only
  /// exists so "shuffle" can give a different-looking avatar within the same avatar_id
  /// style, since Dicebear renders the same picture every time for a given seed+style.
  avatar_seed String?

  /// The onboarding "how do you want to ease in?" answer: 'openers' | 'gradual' | 'volume'.
  /// Constrained by a CHECK that Prisma cannot model — see the migration. Used by the
  /// Meet matcher for "why you matched".
  ease_in String?

  /// An internal metric, never a user input: everyone starts at 1 and it grows as they
  /// interact with people. Onboarding does not ask for it.
  /// Stored rather than derived, even though the messages now live in Postgres and could
  /// in principle be counted: this is a per-person, global stat, whereas channel_xp is
  /// per-conversation. A chat's own warmth does not belong here.
  /// This is the TIER, not the raw counter — it only changes when confidence_points
  /// crosses a badge's tierRequirement. Floored at 1 by a CHECK Prisma can't model —
  /// see the migration.
  confidence_level Int @default(1)

  /// The raw, ever-incrementing counter behind confidence_level. lib/confidence.ts adds
  /// to this on genuine back-and-forth messages; confidence_level only moves up when this
  /// crosses a badges.tierRequirement threshold. Nullable in the DB (no NOT NULL was set
  /// when this column was added) even though every row has the default - matches actual
  /// column state, not a stylistic choice.
  confidence_points Int? @default(0)

  /// Profile page redesign settings - how the profile displays itself and what it shares.
  /// Nullable in the DB for the same reason as confidence_points above.
  display_name_mode String?  @default("username")
  dms_open          Boolean? @default(true)
  show_confidence   Boolean? @default(true)
  show_interests    Boolean? @default(true)
  /// Separate from show_confidence on purpose: a tier is a number that grows with use, where
  /// a badge names a behaviour. Someone can want their progress visible and their habits not.
  show_badges       Boolean? @default(true)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  users             users                 @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gender            genders?              @relation(fields: [gender_id], references: [id], onDelete: SetNull)
  profile_hobbies   profile_hobbies[]
  profile_interests profile_interests[]
  profile_badges    profile_badges[]
  group_member      group_members?
  prompt_awards     prompt_awards[]
  daily_activity    daily_chat_activity[]

  // Two relations to the same model, so they need names to tell them apart.
  games_as_player_one game_sessions[] @relation("game_session_player_one")
  games_as_player_two game_sessions[] @relation("game_session_player_two")

  // Meet actions this profile has taken on others, and those others have taken on it.
  connections_made     connections[] @relation("connection_actor")
  connections_received connections[] @relation("connection_target")

  // Chat. Two relations to conversations, so they need names like the pair above.
  conversation_memberships conversation_members[]
  messages_sent            messages[]
  reactions                message_reactions[]
  waves_sent               conversations[]        @relation("conversation_requester")
  waves_received           conversations[]        @relation("conversation_requestee")

  @@index([gender_id])
  @@schema("public")
}

/// One directional Meet action: `user_id` acted on `other_id`. The matcher excludes any
/// `other_id` the current user already has a row for, so someone greeted never resurfaces
/// on Meet — the conversation is where they live from then on.
///
/// In practice `status` is always 'greeted'. The CHECK constraint in the migration allows
/// more, and this comment used to claim dismissed people were excluded too, but nothing
/// writes a dismissal: Meet has no per-person reject by design (see MoreMatches.tsx), so
/// sayHi is the only thing that ever inserts here.
///
/// scripts/reset-connections.ts clears these when testing, since two accounts otherwise use
/// each other up on the first wave.
model connections {
  user_id    String   @db.Uuid
  other_id   String   @db.Uuid
  status     String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  actor  profiles @relation("connection_actor", fields: [user_id], references: [id], onDelete: Cascade)
  target profiles @relation("connection_target", fields: [other_id], references: [id], onDelete: Cascade)

  @@id([user_id, other_id])
  @@index([other_id])
  @@schema("public")
}

/// A DM or a group chat. Replaces the Stream channel - see docs/chat-rework-plan.md.
///
/// `kind`, the DM/group shape rules, and the "a wave is both markers or neither" rule are
/// CHECK constraints Prisma cannot model; they live in the migration.
model conversations {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// 'dm' | 'group'.
  kind String

  /// Groups only. A DM titles itself from whoever the other member is, so storing a title
  /// would mean storing it twice - once per reader.
  title    String?
  group_id String? @unique @db.Uuid

  /// The wave. requested_of being non-null IS "pending", which is the rule the Stream
  /// custom field of the same name encoded - now a column the Pending tab filters in SQL
  /// instead of a field the client partitions on after fetching everything.
  requested_by String? @db.Uuid
  requested_of String? @db.Uuid

  /// least(a,b):greatest(a,b) of the two member ids, NULL for groups. The unique index on
  /// it is what makes waving at the same person twice reuse the conversation, replacing
  /// Stream's "omit the channel id and it becomes distinct per member pair" behaviour with
  /// something a reader can see.
  dm_key String? @unique

  /// Denormalized so the chat list sorts and previews without a correlated subquery per
  /// row. Written ONLY by the messages_touch_conversation trigger - never by application
  /// code, because the UPDATE it performs is also the realtime signal the list reorders on.
  last_message_at DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  group     groups?   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  requester profiles? @relation("conversation_requester", fields: [requested_by], references: [id], onDelete: SetNull)
  requestee profiles? @relation("conversation_requestee", fields: [requested_of], references: [id], onDelete: SetNull)

  members        conversation_members[]
  messages       messages[]
  xp             channel_xp?
  daily_activity daily_chat_activity[]
  daily_bonuses  daily_bonus_awards[]
  game_sessions  game_sessions[]

  @@schema("public")
}

/// Who is in a conversation. One table for DMs and groups both, which is the thing Stream
/// owning membership made impossible - a DM had no row in group_members at all, so
/// "who is in this chat" had to be an API call (see the old channelMemberIds).
model conversation_members {
  conversation_id String @db.Uuid
  profile_id      String @db.Uuid

  /// Drives the unread badge: messages in this conversation newer than this. Written only
  /// by markRead.
  last_read_at DateTime @default(now()) @db.Timestamptz(6)
  joined_at    DateTime @default(now()) @db.Timestamptz(6)

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  profile      profiles      @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, profile_id])
  /// The primary key leads with conversation_id, so "which conversations am I in" - the
  /// query behind every page load - would sequential-scan without this.
  @@index([profile_id])
  @@schema("public")
}

/// One chat message. `kind` is what Stream's `messageType` custom field was, and is
/// CHECK-constrained in the migration along with the rule that only a prompt_response may
/// carry a prompt_id and only a game_invite a game_type.
model messages {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String @db.Uuid

  /// NULL means the Kindred bot posted it. A bot profile row would need an auth.users row
  /// to point at, and the bot has no account - so absence is the marker.
  ///
  /// Cascades rather than SET NULL on purpose: SET NULL would quietly reattribute a
  /// deleted person's messages to the bot.
  sender_id String? @db.Uuid

  /// 'text' | 'icebreaker_prompt' | 'prompt_response' | 'game_invite'.
  kind String @default("text")
  body String

  /// The quoted message, if this is a reply to one.
  reply_to_id String? @db.Uuid

  /// prompt_response only: which icebreaker this answers. An explicit column rather than a
  /// metadata blob, so IcebreakerCard's "who has answered this prompt" is an index rather
  /// than a scan of everything loaded in the timeline.
  prompt_id String? @db.Uuid

  /// Threaded replies. NULL is a top-level message; non-NULL lives in that message's
  /// thread and is kept out of the main timeline. One level deep, not a tree - the
  /// "parent must itself be top-level" half of that is enforced in lib/chat/mutations.ts,
  /// since a CHECK cannot see the parent row.
  parent_id String? @db.Uuid

  /// game_invite only.
  game_type String?

  /// Soft delete - the timeline keeps the slot, the way Stream's type: "deleted" did.
  deleted_at DateTime? @db.Timestamptz(6)
  edited_at  DateTime? @db.Timestamptz(6)
  pinned_at  DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       profiles?     @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  // Three self-relations, so each needs a name to tell them apart.
  reply_to messages?  @relation("message_reply", fields: [reply_to_id], references: [id], onDelete: SetNull)
  quotes   messages[] @relation("message_reply")
  prompt   messages?  @relation("message_prompt", fields: [prompt_id], references: [id], onDelete: SetNull)
  answers  messages[] @relation("message_prompt")
  parent   messages?  @relation("message_thread", fields: [parent_id], references: [id], onDelete: Cascade)
  thread   messages[] @relation("message_thread")

  reactions     message_reactions[]
  /// Who has already been paid XP for answering this prompt, and the game claimed from this
  /// invite — both used to be opaque Stream ids with no foreign key behind them.
  prompt_awards prompt_awards[]
  game_sessions game_sessions[]

  /// The main timeline is "top-level messages in this conversation, newest first", so
  /// parent_id belongs in the index rather than as a filter applied after it.
  @@index([conversation_id, parent_id, created_at])
  @@index([parent_id])
  @@index([prompt_id])
  @@schema("public")
}

/// One emoji from one person on one message.
///
/// The composite primary key makes reacting twice a no-op instead of a duplicate - the
/// same trick prompt_awards and daily_bonus_awards use to make an insert the claim.
model message_reactions {
  message_id String   @db.Uuid
  profile_id String   @db.Uuid
  emoji      String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  message messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  profile profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@id([message_id, profile_id, emoji])
  @@index([message_id])
  @@schema("public")
}

/// One shared XP total per conversation (group or DM) - not per person. Both/all
/// participants see the same number; it reflects how "warmed up" that specific
/// conversation is, separate from profiles.confidence_level (a per-person, global stat).
///
/// This used to key on Stream's channel_cid, an opaque string no foreign key could point
/// at. 20260726000000_rekey_xp_on_conversations made conversation_id the primary key, so
/// the counter now cascades with the conversation it counts instead of outliving it.
model channel_xp {
  conversation_id String   @id @db.Uuid
  xp              Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// One row per person per icebreaker prompt they have been awarded XP for.
///
/// Answering a prompt grants XP unconditionally - skipping the length and back-and-forth
/// checks every other message has to pass (see lib/confidence.ts). Without a record of
/// what has already been paid out, that exemption is an unlimited faucet: the same prompt
/// can be answered over and over, and the request that awards it can simply be replayed.
/// This table is what makes the guarantee once-per-person-per-prompt.
///
/// prompt_id used to be an opaque Stream message id with nothing behind it. It is now a
/// real foreign key to the icebreaker message, so an award cannot outlive the prompt it
/// paid for - deleting the message takes the award row with it.
model prompt_awards {
  prompt_id  String   @db.Uuid
  profile_id String   @db.Uuid
  awarded_at DateTime @default(now()) @db.Timestamptz(6)

  profile profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  prompt  messages @relation(fields: [prompt_id], references: [id], onDelete: Cascade)

  @@id([prompt_id, profile_id])
  @@schema("public")
}

/// How many XP-qualifying messages one person sent in one chat on one UTC day.
///
/// One counter serving two jobs: it caps how much ordinary chatter can pay out (see
/// DAILY_MESSAGE_XP_CAP), and it decides when everyone in a chat has met the daily
/// threshold for the mutual bonus. Only messages that pass the usual length and
/// turn-taking gates are counted, so "hi" five times earns neither.
///
/// The tally deliberately keeps climbing past the XP cap - only the payment stops. If it
/// stopped counting, a high-level chat whose threshold sits above the cap could never
/// reach its own bonus.
///
/// `day` is a UTC date, not a timestamp: the boundary has to be the same for both people
/// in a conversation regardless of where they are.
///
/// conversation_id is nullable until the phase 7 backfill - see channel_xp above.
model daily_chat_activity {
  conversation_id     String   @db.Uuid
  profile_id          String   @db.Uuid
  day                 DateTime @db.Date
  qualifying_messages Int      @default(0)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  profile      profiles      @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, profile_id, day])
  @@schema("public")
}

/// One row per chat per day that has already paid out its mutual bonus.
///
/// The insert IS the claim, exactly as prompt_awards works: the composite primary key
/// means a replay or a race between two members finishing at the same moment loses
/// rather than paying twice.
///
/// Keyed by conversation, like channel_xp, and cascades with it - a deleted conversation
/// cannot leave a claim behind that would block nothing.
model daily_bonus_awards {
  conversation_id String   @db.Uuid
  day             DateTime @db.Date
  xp_awarded      Int
  awarded_at      DateTime @default(now()) @db.Timestamptz(6)

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, day])
  @@schema("public")
}

/// A 3-4 person group chat, assembled from shared hobbies and interests.
model groups {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The name the group is *formed* with — the top tag its members share.
  ///
  /// Deliberately not kept in step with conversations.title, which is what every chat
  /// surface displays and the only thing renameGroup writes. This copy is read exactly
  /// twice, both before a conversation can exist: to seed the conversation's title, and by
  /// findMyGroup's repair branch when it creates one late. A rename needs a conversation,
  /// so it can never race either read, and nothing displays this value once one exists.
  title String

  created_at DateTime @default(now()) @db.Timestamptz(6)

  members      group_members[]
  conversation conversations?

  @@schema("public")
}

model group_members {
  profile_id String   @id @db.Uuid
  group_id   String   @db.Uuid
  joined_at  DateTime @default(now()) @db.Timestamptz(6)

  profile profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  group   groups   @relation(fields: [group_id], references: [id], onDelete: Cascade)

  /// The primary key only indexes profile_id, so "who else is in my group" would
  /// sequential-scan without this. Same reasoning as profile_hobbies.hobby_id.
  @@index([group_id])
  @@schema("public")
}

/// A two-player turn-based game (Tic-Tac-Toe, Connect Four, ...) played inside a
/// conversation. state is opaque JSON - each game's own logic (components/chat/games/) is
/// the only code that reads or writes its shape. game_type and status are both
/// CHECK-constrained in the migration since Prisma can't model an enum-like string here
/// without a real Postgres enum, and a real enum would need its own migration every
/// time a game is added anyway.
model game_sessions {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Nullable, unlike the XP tables: a game played before the chat rework genuinely has no
  /// conversation to point at, and these rows outlive their chat because lib/games.ts reads
  /// them for the Game Starter and Game Winner badges.
  conversation_id String? @db.Uuid

  game_type     String @db.Text
  player_one_id String @db.Uuid
  player_two_id String @db.Uuid

  /// The game_invite chat message (GameControllerBar.tsx/GameInviteCard.tsx) this
  /// session was claimed from, if it started that way rather than an immediate 1:1
  /// start. A plain @unique, not partial - Postgres already treats every NULL as
  /// distinct, so any number of non-invite (NULL) sessions coexist fine, while this is
  /// what actually makes "first join wins" atomic: two people joining the same invite
  /// race to set the SAME non-null value here, and only one create() can win it.
  invite_message_id String?  @unique @db.Uuid
  state             Json     @db.JsonB
  status            String   @default("in_progress") @db.Text
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  player_one     profiles       @relation("game_session_player_one", fields: [player_one_id], references: [id], onDelete: Cascade)
  player_two     profiles       @relation("game_session_player_two", fields: [player_two_id], references: [id], onDelete: Cascade)
  conversation   conversations? @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  invite_message messages?      @relation(fields: [invite_message_id], references: [id], onDelete: SetNull)

  @@index([conversation_id])
  @@index([player_two_id])
  @@schema("public")
}

model genders {
  id       Int        @id @default(autoincrement()) @db.SmallInt
  code     String     @unique
  label    String
  profiles profiles[]

  @@schema("public")
}

model hobbies {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  profile_hobbies profile_hobbies[]

  @@schema("public")
}

model interests {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  profile_interests profile_interests[]

  @@schema("public")
}

model profile_hobbies {
  profile_id String   @db.Uuid
  hobby_id   Int
  profile    profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  hobby      hobbies  @relation(fields: [hobby_id], references: [id], onDelete: Cascade)

  @@id([profile_id, hobby_id])
  /// The composite primary key only indexes profile_id, so the reverse lookup
  /// ("who else does this hobby") would sequential-scan without this.
  @@index([hobby_id])
  @@schema("public")
}

model profile_interests {
  profile_id  String    @db.Uuid
  interest_id Int
  profile     profiles  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  interest    interests @relation(fields: [interest_id], references: [id], onDelete: Cascade)

  @@id([profile_id, interest_id])
  @@index([interest_id])
  @@schema("public")
}

/// A tier reward on the profile page redesign - unlocked once confidence_points crosses
/// tierRequirement. Reference table, like hobbies/interests: readable by any signed-in
/// user, writable by none of them.
///
/// id has no DB-side default (the live table was hand-created via a raw script, not a
/// migration) - @default(uuid()) generates it in Prisma instead, which works either way.
model badges {
  id              String  @id @default(uuid()) @db.Uuid
  name            String
  description     String
  icon            String?
  tierRequirement Int?

  profile_badges profile_badges[]

  @@schema("public")
}

model profile_badges {
  profile_id String   @db.Uuid
  badge_id   String   @db.Uuid
  profile    profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  badge      badges   @relation(fields: [badge_id], references: [id], onDelete: Cascade)

  @@id([profile_id, badge_id])
  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log_entries {
  instance_id String?   @db.Uuid
  id          String    @id @db.Uuid
  payload     Json?     @db.Json
  created_at  DateTime? @db.Timestamptz(6)
  ip_address  String    @default("") @db.VarChar(64)

  @@index([instance_id], map: "audit_logs_instance_id_idx")
  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model flow_state {
  id                     String                 @id @db.Uuid
  user_id                String?                @db.Uuid
  auth_code              String?
  code_challenge_method  code_challenge_method?
  code_challenge         String?
  provider_type          String
  provider_access_token  String?
  provider_refresh_token String?
  created_at             DateTime?              @db.Timestamptz(6)
  updated_at             DateTime?              @db.Timestamptz(6)
  authentication_method  String
  auth_code_issued_at    DateTime?              @db.Timestamptz(6)
  invite_token           String?
  referrer               String?
  oauth_client_state_id  String?                @db.Uuid
  linking_target_id      String?                @db.Uuid
  email_optional         Boolean                @default(false)
  saml_relay_states      saml_relay_states[]

  @@index([created_at(sort: Desc)])
  @@index([auth_code], map: "idx_auth_code")
  @@index([user_id, authentication_method], map: "idx_user_id_auth_method")
  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model identities {
  provider_id     String
  user_id         String    @db.Uuid
  identity_data   Json
  provider        String
  last_sign_in_at DateTime? @db.Timestamptz(6)
  created_at      DateTime? @db.Timestamptz(6)
  updated_at      DateTime? @db.Timestamptz(6)
  email           String?   @default(dbgenerated("lower((identity_data ->> 'email'::text))"))
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider_id, provider], map: "identities_provider_id_provider_unique")
  @@index([email])
  @@index([user_id])
  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model instances {
  id              String    @id @db.Uuid
  uuid            String?   @db.Uuid
  raw_base_config String?
  created_at      DateTime? @db.Timestamptz(6)
  updated_at      DateTime? @db.Timestamptz(6)

  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mfa_amr_claims {
  session_id            String   @db.Uuid
  created_at            DateTime @db.Timestamptz(6)
  updated_at            DateTime @db.Timestamptz(6)
  authentication_method String
  id                    String   @id(map: "amr_id_pk") @db.Uuid
  sessions              sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, authentication_method], map: "mfa_amr_claims_session_id_authentication_method_pkey")
