generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id         String    @id @db.Uuid
  username   String    @unique
  /// Age is derived from this on read: storing an age integer goes stale silently.
  birth_date DateTime? @db.Date
  gender_id  Int?      @db.SmallInt
  avatar_id  String?

  /// The onboarding "how do you want to ease in?" answer: 'openers' | 'gradual' | 'volume'.
  /// Constrained by a CHECK that Prisma cannot model — see the migration. Used by the
  /// Meet matcher for "why you matched".
  ease_in String?

  /// An internal metric, never a user input: everyone starts at 1 and it grows as they
  /// interact with people. Onboarding does not ask for it.
  /// Not derived data: the interactions live in Stream Chat, never in Postgres.
  /// A chat's difficulty level is a property of the chat and does not belong here.
  /// Uncapped, floored at 1 by a CHECK that Prisma cannot model — see the migration.
  confidence_level Int @default(1)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Privacy & Redesign settings
  display_name_mode String?  @default("username")
  dms_open          Boolean? @default(true)
  show_confidence   Boolean? @default(true)
  show_interests    Boolean? @default(true)
  
  // Confidence leveling
  confidence_points Int?     @default(0)

  users             users               @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gender            genders?            @relation(fields: [gender_id], references: [id], onDelete: SetNull)
  profile_hobbies   profile_hobbies[]
  profile_interests profile_interests[]
  profile_badges    profile_badges[]

  // Meet actions this profile has taken on others, and those others have taken on it.
  connections_made     connections[] @relation("connection_actor")
  connections_received connections[] @relation("connection_target")

  @@index([gender_id])
  @@schema("public")
}

/// One directional Meet action: `user_id` acted on `other_id`. The matcher excludes any
/// `other_id` the current user already has a row for, so dismissed and greeted people do
/// not resurface. `status` is CHECK-constrained in the migration (Prisma can't model it).
model connections {
  user_id    String   @db.Uuid
  other_id   String   @db.Uuid
  status     String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  actor  profiles @relation("connection_actor", fields: [user_id], references: [id], onDelete: Cascade)
  target profiles @relation("connection_target", fields: [other_id], references: [id], onDelete: Cascade)

  @@id([user_id, other_id])
  @@index([other_id])
  @@schema("public")
}

model genders {
  id       Int        @id @default(autoincrement()) @db.SmallInt
  code     String     @unique
  label    String
  profiles profiles[]

  @@schema("public")
}

model hobbies {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  profile_hobbies profile_hobbies[]

  @@schema("public")
}

model interests {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  profile_interests profile_interests[]

  @@schema("public")
}

model profile_hobbies {
  profile_id String   @db.Uuid
  hobby_id   Int
  profile    profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  hobby      hobbies  @relation(fields: [hobby_id], references: [id], onDelete: Cascade)

  @@id([profile_id, hobby_id])
  /// The composite primary key only indexes profile_id, so the reverse lookup
  /// ("who else does this hobby") would sequential-scan without this.
  @@index([hobby_id])
  @@schema("public")
}

model profile_interests {
  profile_id  String    @db.Uuid
  interest_id Int
  profile     profiles  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  interest    interests @relation(fields: [interest_id], references: [id], onDelete: Cascade)

  @@id([profile_id, interest_id])
  @@index([interest_id])
  @@schema("public")
}

model badges {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String
  icon            String?
  tierRequirement Int?
  
  profile_badges  profile_badges[]

  @@schema("public")
}

model profile_badges {
  profile_id String   @db.Uuid
  badge_id   String   @db.Uuid
  profile    profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  badge      badges   @relation(fields: [badge_id], references: [id], onDelete: Cascade)

  @@id([profile_id, badge_id])
  @@schema("public")
}

