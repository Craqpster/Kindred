# Copy to .env and fill in. Never commit the result — .gitignore covers `.env*`, and this
# example is the only one allowed through.

# ---- Postgres / Prisma (server-side only) ----
# Supabase Dashboard -> Project Settings -> Database -> Connection string
#
# DATABASE_URL: the "Transaction" pooler tab (port 6543). Used by Prisma Client at runtime.
# DIRECT_URL:   the "Session" pooler tab (port 5432). Used by the Prisma CLI (db pull, migrate).
#
# Both are needed. Migrations cannot run through the transaction pooler — it cannot hold the
# advisory locks they take — which is why prisma.config.ts hands the CLI DIRECT_URL instead.
#
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
# An unescaped character here surfaces as a confusing "P1000: authentication failed".
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---- Supabase auth and realtime (utils/supabase/*) ----
# Dashboard -> Project Settings -> API
#
# The publishable key is the browser's, and it carries no privileges of its own: what a
# signed-in user may read is decided by the RLS policies on the chat tables, and the browser
# has no write grant at all. See 20260725010000_grant_chat_read_to_authenticated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- OpenAI (message moderation) ----
# platform.openai.com -> API keys. Used by lib/chat/moderation.ts as the second layer of the
# check; the local word list runs first and catches most things without a request.
#
# The app runs without it — moderation fails OPEN by design, so an outage lets messages
# through rather than taking chat down with it. Set it for anything resembling real use.
OPENAI_API_KEY=
